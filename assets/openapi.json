{
  "openapi": "3.1.0",
  "info": {
    "title": "Cloud CLI Auth API",
    "version": "1.0.0",
    "description": "OIDC provider endpoints, versioned Auth APIs, and JavaScript integration modules. UI pages and UI-only assets are omitted."
  },
  "servers": [
    {
      "url": "__HOSTNAME__"
    }
  ],
  "tags": [
    {
      "name": "Profile",
      "description": "Current user profile and session endpoints."
    },
    {
      "name": "Properties"
    },
    {
      "name": "API tokens",
      "description": "Opaque API tokens scoped to registered OIDC clients."
    },
    {
      "name": "JWT APIs",
      "description": "OIDC protocol, JWT discovery, and session token endpoints."
    },
    {
      "name": "Admin-only APIs",
      "description": "Administrator endpoints for managing OIDC clients, Auth API tokens, and JWT signing keys."
    },
    {
      "name": "UI-only APIs",
      "description": "Authentication and dashboard endpoints used by the Auth browser UI."
    },
    {
      "name": "Browser client"
    },
    {
      "name": "Node client"
    }
  ],
  "paths": {
    "/api/v1/profile": {
      "get": {
        "tags": ["Profile"],
        "summary": "Get the current user",
        "responses": {
          "200": {
            "description": "Current authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "description": "Authenticated user no longer exists"
          }
        }
      },
      "head": {
        "tags": ["Profile"],
        "summary": "Check whether the current session is authenticated",
        "responses": {
          "204": {
            "description": "Authenticated"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      },
      "delete": {
        "tags": ["Profile"],
        "summary": "Sign out the current user",
        "responses": {
          "202": {
            "description": "Signed out"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "500": {
            "description": "Sign-out failed"
          }
        }
      }
    },
    "/api/v1/profile/preferred-username": {
      "put": {
        "tags": ["Profile"],
        "summary": "Set the user's preferred username once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["preferred_username"],
                "properties": {
                  "preferred_username": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,28}[A-Za-z0-9]?$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Username set"
          },
          "400": {
            "description": "Invalid username"
          },
          "409": {
            "description": "Username already set or taken"
          }
        }
      }
    },
    "/api/v1/properties": {
      "get": {
        "tags": ["Properties"],
        "summary": "List the current user's properties",
        "responses": {
          "200": {
            "description": "Properties",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Property"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      },
      "put": {
        "tags": ["Properties"],
        "summary": "Create or update a property for the current user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PropertyInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved property",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Property"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "500": {
            "description": "Invalid input or storage failure"
          }
        }
      }
    },
    "/api/v1/properties/{key}": {
      "parameters": [
        {
          "name": "key",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": ["Properties"],
        "summary": "Get a property for the current user",
        "responses": {
          "200": {
            "description": "Property",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Property"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "404": {
            "description": "Property not found"
          }
        }
      },
      "delete": {
        "tags": ["Properties"],
        "summary": "Delete a property for the current user",
        "responses": {
          "202": {
            "description": "Property deleted"
          },
          "400": {
            "description": "Missing property key"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "500": {
            "description": "Storage failure"
          }
        }
      }
    },
    "/api/v1/session/token": {
      "post": {
        "tags": ["JWT APIs"],
        "summary": "Issue a short-lived access token for an allowed audience",
        "description": "Requires an authenticated browser session and an Origin listed in AUTH_ALLOWED_ORIGINS.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["audience"],
                "properties": {
                  "audience": {
                    "type": "string",
                    "description": "A value configured in JWT_AUDIENCES"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bearer access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "400": {
            "description": "Invalid audience"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "description": "Origin is not allowed"
          },
          "503": {
            "description": "JWT service is not configured"
          }
        }
      }
    },
    "/api/v1/oidc/clients": {
      "get": {
        "tags": ["Admin-only APIs"],
        "summary": "List managed OIDC clients",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Managed clients without secrets"
          },
          "403": {
            "description": "Administrator access required"
          }
        }
      },
      "post": {
        "tags": ["Admin-only APIs"],
        "summary": "Create a managed OIDC client",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id", "redirectUris"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "redirectUris": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "postLogoutRedirectUris": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "isPublic": {
                    "type": "boolean",
                    "description": "Public/native applications omit client_secret and authenticate using PKCE."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Client; confidential clients also receive a one-time secret"
          },
          "400": {
            "description": "Invalid client"
          },
          "403": {
            "description": "Administrator access required"
          }
        }
      }
    },
    "/api/v1/audit": {
      "get": {
        "tags": ["UI-only APIs"],
        "summary": "List the current user's authentication audit events",
        "responses": {
          "200": {
            "description": "Authentication timeline"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/api/v1/oidc/clients/{id}": {
      "delete": {
        "tags": ["Admin-only APIs"],
        "summary": "Remove a managed OIDC client",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "403": {
            "description": "Administrator access required"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/oidc/clients/{id}/logout-redirects": {
      "put": {
        "tags": ["Admin-only APIs"],
        "summary": "Set post-logout redirect URLs for an OIDC client",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["postLogoutRedirectUris"],
                "properties": {
                  "postLogoutRedirectUris": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved post-logout redirect URLs"
          },
          "400": {
            "description": "Invalid client or redirect URI"
          },
          "403": {
            "description": "Administrator access required"
          }
        }
      }
    },
    "/api/v1/oidc/clients/{id}/secret": {
      "put": {
        "tags": ["Admin-only APIs"],
        "summary": "Regenerate a managed OIDC client secret",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Regenerated secret",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "secret"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "secret": {
                      "type": "string"
                    },
                    "redirectUris": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uri"
                      }
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Administrator access required"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/oidc/clients/{id}/scopes": {
      "put": {
        "tags": ["Admin-only APIs"],
        "summary": "Replace the allowed API scopes for a managed OIDC client",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["scopes"],
                "properties": {
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated scopes"
          },
          "400": {
            "description": "Invalid client or scope"
          },
          "403": {
            "description": "Administrator access required"
          }
        }
      }
    },
    "/api/v1/api-tokens/{clientId}": {
      "get": {
        "tags": ["API tokens"],
        "summary": "List the current user's tokens for an OIDC app",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token metadata without token values"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      },
      "post": {
        "tags": ["API tokens"],
        "summary": "Create a scoped opaque API token",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["label", "scopes"],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token value, shown once"
          },
          "400": {
            "description": "Invalid app or scope"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/api/v1/api-tokens/{clientId}/{tokenId}": {
      "delete": {
        "tags": ["API tokens"],
        "summary": "Revoke a token by stable token ID",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "404": {
            "description": "Token not found"
          }
        }
      }
    },
    "/api/v1/api-tokens/{clientId}/issue": {
      "post": {
        "tags": ["API tokens"],
        "summary": "Mint a downstream API token using an Auth API token",
        "description": "Requires an Auth API Bearer token issued to clientId. This credential has the fixed permission to mint tokens only for its own client. The request's downstream scopes must be configured for that OIDC client. The returned opaque token is shown once.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["label", "scopes"],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Opaque token and expiry"
          },
          "400": {
            "description": "Unknown client or invalid scope"
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked Auth API token"
          }
        }
      }
    },
    "/api/v1/auth-api-tokens/{clientId}": {
      "parameters": [
        {
          "name": "clientId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": ["Admin-only APIs"],
        "summary": "List Auth API tokens for a client (administrator only)",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Token metadata, never token values"
          },
          "403": {
            "description": "Administrator access required"
          }
        }
      },
      "post": {
        "tags": ["Admin-only APIs"],
        "summary": "Create an Auth API token for a client (administrator only)",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["label"],
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "A label for this fixed-permission token"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token value, shown once"
          },
          "400": {
            "description": "Unknown client"
          },
          "403": {
            "description": "Administrator access required"
          }
        }
      }
    },
    "/api/v1/auth-api-tokens/{clientId}/{tokenId}": {
      "delete": {
        "tags": ["Admin-only APIs"],
        "summary": "Revoke an Auth API token (administrator only)",
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "403": {
            "description": "Administrator access required"
          },
          "404": {
            "description": "Token not found"
          }
        }
      }
    },
    "/oauth/introspect": {
      "post": {
        "tags": ["JWT APIs"],
        "summary": "Introspect an opaque API token",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "token_type_hint": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RFC 7662 token status"
          }
        }
      }
    },
    "/authorize": {
      "get": {
        "tags": ["JWT APIs"],
        "summary": "Start an OIDC authorization-code flow",
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "const": "code"
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "Space-delimited. If omitted or blank, defaults to openid; only openid, profile, and email are supported.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nonce",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "const": "S256"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to sign-in, or to a registered callback with authorization response or standard OAuth error parameters"
          },
          "400": {
            "description": "Branded HTML error page with retry and home actions when the callback cannot be trusted"
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": ["JWT APIs"],
        "summary": "End the Auth browser session for an OIDC relying party",
        "parameters": [
          {
            "name": "client_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id_token_hint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "post_logout_redirect_uri",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the registered post-logout URI or Auth home"
          },
          "400": {
            "description": "Invalid ID Token hint or unregistered post-logout URI"
          }
        }
      }
    },
    "/token": {
      "post": {
        "tags": ["JWT APIs"],
        "summary": "Exchange an OIDC authorization code",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["grant_type", "code", "client_id", "redirect_uri", "code_verifier"],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "const": "authorization_code"
                  },
                  "code": {
                    "type": "string"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  },
                  "redirect_uri": {
                    "type": "string",
                    "format": "uri"
                  },
                  "code_verifier": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access and identity tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OidcTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or authorization code"
          },
          "503": {
            "description": "JWT service is not configured"
          }
        }
      }
    },
