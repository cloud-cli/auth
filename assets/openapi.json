      "get": {
        "tags": ["Admin-only APIs"],
        "summary": "List users for administrators",
        "responses": {
          "200": {
            "description": "Users ordered by email"
          },
          "403": {
            "description": "Administrator access required"
          }
        }
      }
    },
    "/api/v1/admin/users/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "tags": ["Admin-only APIs"],
        "summary": "Update a user username, suspension, or Google identity block",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "preferred_username": {
                    "type": "string"
                  },
                  "disabled": {
                    "type": "boolean"
                  },
                  "blocked": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid update"
          },
          "403": {
            "description": "Administrator access required"
          },
          "409": {
            "description": "Would lock out administrator"
          }
        }
      },
      "delete": {
        "tags": ["Admin-only APIs"],
        "summary": "Permanently delete a user and associated data",
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "403": {
            "description": "Administrator access required"
          },
          "409": {
            "description": "Cannot delete the final administrator"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "photo", "role", "preferred_username"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "photo": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["user", "admin"]
          },
          "preferred_username": {
            "type": ["string", "null"]
          }
        }
      },
      "OidcUserInfo": {
        "type": "object",
        "required": ["sub"],
        "properties": {
          "sub": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "preferred_username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "picture": {
            "type": "string",
            "format": "uri"
          },
          "photo": {
            "type": "string",
            "format": "uri",
            "description": "Compatibility alias for picture."
          }
        }
      },
      "PropertyInput": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "Property": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PropertyInput"
          },
          {
            "type": "object",
            "properties": {
              "uid": {
                "type": "string"
              },
              "userId": {
                "type": "string"
              }
            }
          }
        ]
      },
      "AccessToken": {
        "type": "object",
        "required": ["access_token", "token_type", "expires_in"],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 60,
            "maximum": 900
          }
        }
      },
      "OidcTokenResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AccessToken"
          },
          {
            "type": "object",
            "required": ["id_token"],
            "properties": {
              "id_token": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid"
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "No authenticated session"
      }
    }
  }
}
