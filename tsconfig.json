{
  "extends": "@cloud-cli/typescript-config",
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "lib": ["esnext", "dom"],
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": false
  },
  "include": ["src/"]
}
