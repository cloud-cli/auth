{
  "name": "auth",
  "private": true,
  "version": "0.0.0",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && esbuild dist/src/index.js --bundle --packages=external --platform=node --format=esm --outfile=dist/index.js --define:__TEST__=${BUILD_TEST_ROUTES:-false}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:integration": "playwright test",
    "migrate": "pnpm build && node ./dist/db/migrations/004_restrict_admin_role.js",
    "start": "node ./dist/index.js"
  },
  "prettier": "@cloud-cli/prettier-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-cli/auth.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@cloud-cli/prettier-config": "^1.0.0",
    "@cloud-cli/typescript-config": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.17.7",
    "@types/node": "^26.1.2",
    "@types/passport": "^1.0.12",
    "@types/passport-google-oauth20": "^2.0.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.1",
    "express": "^4.21.2",
    "express-session": "^1.18.0",
    "jose": "^6.2.12",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4"
  }
}
